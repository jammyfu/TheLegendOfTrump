{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thelegendoftrump",
  "compatibility_date": "2026-09-10",
  "main": "workers/subdir-assets.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
